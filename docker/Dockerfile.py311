FROM costrouc/pysrim:latest

# 0) import Debian archive keys (avoids NO_PUBKEY errors)
RUN apt-get update || true && apt-get install -y --no-install-recommends gnupg dirmngr
RUN apt-key adv --keyserver hkp://keyserver.ubuntu.com:80 \
    --recv-keys 648ACFD622F3D138 0E98404D386FA1D9 DCC9EFBF77E11517 \
               112695A0E562B32A 54404762BBB6E853

# 1) build-deps + Python 3.11
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential wget libssl-dev zlib1g-dev libbz2-dev libreadline-dev \
    libsqlite3-dev libncursesw5-dev tk-dev libxml2-dev libxmlsec1-dev \
    libffi-dev liblzma-dev && \
    wget https://www.python.org/ftp/python/3.11.9/Python-3.11.9.tgz && \
    tar -xf Python-3.11.9.tgz && cd Python-3.11.9 && \
    ./configure --enable-optimizations && make -j"$(nproc)" && make altinstall && \
    cd .. && rm -rf Python-3.11.9*

# 2) **git client so pip can pull from GitHub**
RUN apt-get update && apt-get install -y --no-install-recommends git   # ← added

# 3) install pysrim on Python 3.11
RUN python3.11 -m pip install --upgrade pip && \
    python3.11 -m pip install git+https://github.com/costrouc/pysrim.git@master

# Patch yaml.load → yaml.safe_load (no heredoc needed)
RUN sed -i 's/yaml\.load(/yaml.safe_load(/' \
    /usr/local/lib/python3.11/site-packages/srim/core/elementdb.py && \
    echo "✓ Patched elementdb.py"

# enable contrib + non-free, then update indexes
RUN sed -i 's/ buster main/ buster main contrib non-free/' /etc/apt/sources.list && \
    apt-get update

# 4) install winetricks + VB5 runtime so TRIM.exe never crashes   :contentReference[oaicite:5]{index=5}
RUN apt-get install -y --no-install-recommends winetricks xvfb && \
    WINEARCH=win32 winetricks -q vb5run

# 5) force every Wine call into a fake X-server (no real display needed)   :contentReference[oaicite:6]{index=6}
ENV WINEDEBUG=-all DISPLAY=:99
RUN printf '#!/bin/sh\nexec xvfb-run -a wine \"$@\"' >/usr/local/bin/wine && chmod +x /usr/local/bin/wine

# 6) copy your demo script(s) and notebooks into the image
COPY examples/docker/ni.py /workspace/ni.py
COPY examples/notebooks/ /workspace/notebooks

WORKDIR /workspace
ENTRYPOINT ["python3.11", "ni.py"]
